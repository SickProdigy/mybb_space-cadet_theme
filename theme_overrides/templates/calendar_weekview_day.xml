<template name="calendar_weekview_day" version="1400"><![CDATA[<article class="calendar_week_day{$day_shaded}">
	<header class="calendar_weekday_heading">
		<span>{$weekday_name}</span>
		<strong class="calendar_weekday_number">{$weekday_day}</strong>
	</header>
	<div class="calendar_weekday_content">{$day_birthdays}{$day_events}</div>
</article>]]></template>
