<template name="portal_latestthreads_thread" version="1812"><![CDATA[<tr class="space_cadet_activity" data-replies="{$thread['replies']}">
<td class="{$altbg}">
<strong class="portal_activity_title"><a class="activity_thread" href="{$mybb->settings['bburl']}/{$thread['threadlink']}" title="{$thread['fullsubject']}">{$thread['fullsubject']}</a></strong>
<span class="smalltext portal_activity_forum">{$lang->forum} <a href="{$thread['forumlink']}">{$thread['forumname']}</a></span>
<span class="smalltext portal_activity_meta">
	<span><a class="activity_lastpost" href="{$thread['lastpostlink']}">{$lang->latest_threads_lastpost}</a> <span class="activity_author">{$lastposterlink}</span></span>
	<span class="portal_activity_stat">{$lang->latest_threads_replies} {$thread['replies']}</span>
	<time class="activity_date">{$lastpostdate}</time>
	<span class="portal_activity_stat">{$lang->latest_threads_views} {$thread['views']}</span>
</span>
</td>
</tr>]]></template>
