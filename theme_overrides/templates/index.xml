<template name="index" version="1817"><![CDATA[<html>
<head>
<title>{$mybb->settings['bbname']}</title>
{$headerinclude}
<script type="text/javascript">
<!--
	lang.no_new_posts = "{$lang->no_new_posts}";
	lang.click_mark_read = "{$lang->click_mark_read}";
// -->
</script>
</head>
<body>
{$header}

<div class="index_layout">
	<main class="index_forums">
		{$forums}
		{$boardstats}

		<dl class="forum_legend smalltext">
			<dt><span class="forum_status forum_on" title="{$lang->new_posts}"></span></dt>
			<dd>{$lang->new_posts}</dd>

			<dt><span class="forum_status forum_off" title="{$lang->no_new_posts}"></span></dt>
			<dd>{$lang->no_new_posts}</dd>

			<dt><span class="forum_status forum_offclose" title="{$lang->forum_closed}"></span></dt>
			<dd>{$lang->forum_closed}</dd>

			<dt><span class="forum_status forum_offlink" title="{$lang->forum_redirect}"></span></dt>
			<dd>{$lang->forum_redirect}</dd>
		</dl>
		<br class="clear" />
	</main>

	<aside class="index_sidebar" aria-label="Forum sidebar">
		<section class="sidebar_panel">
			<h2 class="thead">Go Social</h2>
			<div class="sidebar_content social_links">
				<a class="discord" href="https://discord.gg/eQj8wyY" aria-label="Discord"><i class="fa-brands fa-discord" aria-hidden="true"></i></a>
				<a class="instagram" href="https://www.instagram.com/SickGamingNet" aria-label="Instagram"><i class="fa-brands fa-instagram" aria-hidden="true"></i></a>
				<a class="facebook" href="https://www.facebook.com/S1ckGaming" aria-label="Facebook"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i></a>
				<a class="twitter" href="https://x.com/_SickGaming" aria-label="X"><i class="fa-brands fa-twitter" aria-hidden="true"></i></a>
				<a class="telegram" href="https://t.me/Sick_Gaming" aria-label="Telegram"><i class="fa-brands fa-telegram" aria-hidden="true"></i></a>
				<a class="youtube" href="https://www.youtube.com/SickGamingNet/" aria-label="YouTube"><i class="fa-brands fa-youtube" aria-hidden="true"></i></a>
			</div>
		</section>

		<section class="sidebar_panel">
			<h2 class="thead">Latest Posts</h2>
			<div class="sidebar_content">
				<ul class="latest_posts" id="latest_posts"><li>Loading latest posts&hellip;</li></ul>
			</div>
		</section>
	</aside>
</div>
<br class="clear" />
<script type="text/javascript">
document.addEventListener("DOMContentLoaded", function() {
	var list = document.getElementById("latest_posts");
	var feedUrl = "{$mybb->settings['bburl']}/syndication.php?limit=5";

	fetch(feedUrl, { credentials: "same-origin" })
		.then(function(response) {
			if (!response.ok) throw new Error("Feed request failed");
			return response.text();
		})
		.then(function(source) {
			var feed = new DOMParser().parseFromString(source, "application/xml");
			var items = Array.prototype.slice.call(feed.querySelectorAll("item"), 0, 5);
			if (!items.length) throw new Error("No feed items");

			list.textContent = "";
			items.forEach(function(item) {
				var title = item.querySelector("title");
				var link = item.querySelector("link");
				var date = item.querySelector("pubDate");
				var row = document.createElement("li");
				var anchor = document.createElement("a");
				anchor.href = link ? link.textContent : feedUrl;
				anchor.textContent = title ? title.textContent : "Forum post";
				row.appendChild(anchor);
				if (date) {
					var time = document.createElement("time");
					time.textContent = new Date(date.textContent).toLocaleString();
					row.appendChild(time);
				}
				list.appendChild(row);
			});
		})
		.catch(function() {
			list.innerHTML = '<li><a href="' + feedUrl + '">View the latest forum posts</a></li>';
		});
});
</script>
{$footer}
</body>
</html>]]></template>
