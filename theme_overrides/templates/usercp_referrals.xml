<template name="usercp_referrals" version="1600"><![CDATA[<tr>
<td class="trow2 usercp_referral_row" colspan="{$colspan}">
<div class="usercp_referral_callout">
	<span>Invite new members with your personal referral link:</span>
	<div class="usercp_referral_actions">
	<a id="usercp_referral_url" class="usercp_referral_url" href="{$mybb->settings['bburl']}/member.php?action=register&amp;referrer={$mybb->user['uid']}">{$mybb->settings['bburl']}/member.php?action=register&amp;referrer={$mybb->user['uid']}</a>
	<button type="button" class="button usercp_referral_copy" onclick="copyUsercpReferral(this);">Copy link</button>
	</div>
<script type="text/javascript">
function copyUsercpReferral(button)
{
	var referralUrl = document.getElementById("usercp_referral_url").href;
	var copied = function() {
		button.textContent = "Copied";
		window.setTimeout(function() { button.textContent = "Copy link"; }, 1600);
	};

	if(navigator.clipboard && window.isSecureContext)
	{
		navigator.clipboard.writeText(referralUrl).then(copied);
		return;
	}

	var field = document.createElement("textarea");
	field.value = referralUrl;
	field.style.position = "fixed";
	field.style.opacity = "0";
	document.body.appendChild(field);
	field.select();
	document.execCommand("copy");
	document.body.removeChild(field);
	copied();
}
</script>
</div>
</td>
</tr>]]></template>
