<template name="portal_announcement" version="1800"><![CDATA[<article class="portal_announcement tborder">
	<h2 class="thead portal_announcement_subject">{$icon} <a href="{$mybb->settings['bburl']}/{$announcement['threadlink']}">{$announcement['subject']}</a></h2>
	<div class="trow1 portal_announcement_content">
		<header class="portal_announcement_header">
			{$avatar}
			<div class="portal_announcement_heading">
				<div class="portal_announcement_author">{$profilelink}</div>
				<div class="portal_announcement_meta smalltext">{$anndate} &middot; {$lang->forum} <a href="{$mybb->settings['bburl']}/{$announcement['forumlink']}">{$announcement['forumname']}</a> {$numcomments}</div>
			</div>
		</header>
		<div class="portal_announcement_body scaleimages">
			{$message}
			{$post['attachments']}
		</div>
		<footer class="portal_announcement_footer">
			<a class="portal_announcement_action" href="{$mybb->settings['bburl']}/printthread.php?tid={$announcement['tid']}" title="{$lang->print_this_item}">
				<i class="fa-solid fa-print" aria-hidden="true"></i><span>Print</span>
			</a>
			<div class="portal_share">
				<button class="portal_announcement_action portal_share_toggle" type="button" aria-expanded="false" aria-haspopup="true" data-thread-url="{$mybb->settings['bburl']}/{$announcement['threadlink']}">
					<i class="fa-solid fa-share-nodes" aria-hidden="true"></i><span>Share</span>
				</button>
				<div class="portal_share_menu" role="menu" hidden>
					<button class="portal_share_option portal_native_share" type="button" role="menuitem"><i class="fa-solid fa-arrow-up-from-bracket" aria-hidden="true"></i><span>Share via&hellip;</span></button>
					<a class="portal_share_option portal_email_share" href="#" role="menuitem"><i class="fa-solid fa-envelope" aria-hidden="true"></i><span>Email</span></a>
					<a class="portal_share_option portal_facebook_share" href="#" target="_blank" rel="noopener noreferrer" role="menuitem"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i><span>Facebook</span></a>
					<a class="portal_share_option portal_x_share" href="#" target="_blank" rel="noopener noreferrer" role="menuitem"><i class="fa-brands fa-twitter" aria-hidden="true"></i><span>X</span></a>
					<a class="portal_share_option portal_reddit_share" href="#" target="_blank" rel="noopener noreferrer" role="menuitem"><i class="fa-brands fa-reddit-alien" aria-hidden="true"></i><span>Reddit</span></a>
					<button class="portal_share_option portal_copy_share" type="button" role="menuitem"><i class="fa-solid fa-link" aria-hidden="true"></i><span>Copy link</span></button>
				</div>
			</div>
		</footer>
	</div>
</article>]]></template>
