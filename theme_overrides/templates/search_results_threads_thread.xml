<template name="search_results_threads_thread" version="1813"><![CDATA[<tr class="inline_row search_result_row">
	<td align="center" class="{$bgcolor} search_result_status" width="2%"><span class="thread_status {$folder}" title="{$folder_label}">&nbsp;</span></td>
	<td align="center" class="{$bgcolor} search_result_icon" width="2%">{$icon}</td>
	<td class="{$bgcolor} search_result_subject">
		{$attachment_count}
		<div class="search_result_mobile_identity">
			<span>{$prefix} {$gotounread}{$thread['threadprefix']}<a href="{$thread_link}{$highlight}" class="{$inline_edit_class} {$new_class}" id="tid_{$inline_edit_tid}">{$thread['subject']}</a>{$thread['multipage']}</span>
			<div class="author smalltext"><span class="search_result_mobile_label"><strong>{$lang->author}:</strong> </span>{$thread['profilelink']}</div>
			<div class="search_result_mobile_forum"><strong>{$lang->forum}:</strong> {$thread['forumlink']}</div>
		</div>
		<div class="search_result_mobile_side">
			<div class="search_result_mobile_stats"><span><strong>{$lang->replies}</strong> {$thread['replies']}</span><span><strong>{$lang->views}</strong> {$thread['views']}</span></div>
			<div class="search_result_mobile_footer"><span><strong>{$lang->lastpost}:</strong> <a href="{$thread['lastpostlink']}"><span class="smalltext">{$lastpostdate}</span></a><span class="search_result_mobile_lastposter">{$lastposterlink}</span></span></div>
		</div>
	</td>
	<td class="{$bgcolor} search_result_meta search_result_forum" data-label="{$lang->forum}">{$thread['forumlink']}</td>
	<td align="center" class="{$bgcolor} search_result_meta search_result_replies" data-label="{$lang->replies}"><a href="{$mybb->settings['bburl']}/misc.php?action=whoposted&tid={$thread['tid']}" onclick="MyBB.whoPosted({$thread['tid']}); return false;">{$thread['replies']}</a></td>
	<td align="center" class="{$bgcolor} search_result_meta search_result_views" data-label="{$lang->views}">{$thread['views']}</td>
	<td class="{$bgcolor} search_result_meta search_result_date" data-label="{$lang->lastpost}" style="white-space: nowrap">
		<span class="smalltext">
			{$lastpostdate}<br />
			<a href="{$thread['lastpostlink']}">{$lang->lastpost}</a>: {$lastposterlink}
		</span>
	</td>
	{$inline_mod_checkbox}
</tr>]]></template>
