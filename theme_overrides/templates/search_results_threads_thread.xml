<template name="search_results_threads_thread" version="1813"><![CDATA[<tr class="inline_row search_result_row">
	<td align="center" class="{$bgcolor} search_result_status" width="2%"><span class="thread_status {$folder}" title="{$folder_label}">&nbsp;</span></td>
	<td align="center" class="{$bgcolor} search_result_icon" width="2%">{$icon}</td>
	<td class="{$bgcolor} search_result_subject">
		{$attachment_count}
		<div>
			<span>{$prefix} {$gotounread}{$thread['threadprefix']}<a href="{$thread_link}{$highlight}" class="{$inline_edit_class} {$new_class}" id="tid_{$inline_edit_tid}">{$thread['subject']}</a>{$thread['multipage']}</span>
			<div class="author smalltext">{$thread['profilelink']}</div>
		</div>
	</td>
	<td class="{$bgcolor} search_result_meta" data-label="{$lang->forum}">{$thread['forumlink']}</td>
	<td align="center" class="{$bgcolor} search_result_meta" data-label="{$lang->replies}"><a href="{$mybb->settings['bburl']}/misc.php?action=whoposted&tid={$thread['tid']}" onclick="MyBB.whoPosted({$thread['tid']}); return false;">{$thread['replies']}</a></td>
	<td align="center" class="{$bgcolor} search_result_meta" data-label="{$lang->views}">{$thread['views']}</td>
	<td class="{$bgcolor} search_result_meta search_result_date" data-label="{$lang->lastpost}" style="white-space: nowrap">
		<span class="smalltext">
			{$lastpostdate}<br />
			<a href="{$thread['lastpostlink']}">{$lang->lastpost}</a>: {$lastposterlink}
		</span>
	</td>
	{$inline_mod_checkbox}
</tr>]]></template>
