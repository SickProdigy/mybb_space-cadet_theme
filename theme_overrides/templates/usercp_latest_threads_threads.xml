<td align="center" class="{$bgcolor}" width="2%">{$icon}</td>
<td class="{$bgcolor} usercp_latest_thread_identity">{$gotounread}{$thread['displayprefix']}<a href="{$thread['threadlink']}" class="{$new_class}">{$thread['subject']}</a><br /><span class="smalltext">{$thread['author']}</span></td>
<td align="center" class="{$bgcolor} usercp_latest_thread_replies" data-label="{$lang->replies}"><a href="{$mybb->settings['bburl']}/misc.php?action=whoposted&tid={$thread['tid']}" onclick="MyBB.whoPosted({$thread['tid']}); return false;">{$thread['replies']}</a></td>
<td align="center" class="{$bgcolor} usercp_latest_thread_views" data-label="{$lang->views}">{$thread['views']}</td>
<td class="{$bgcolor} usercp_latest_thread_lastpost" style="white-space: nowrap"><span class="smalltext">{$lastpostdate}
<br /><a href="{$thread['lastpostlink']}">{$lang->lastpost}</a>: {$lastposterlink}</span>
