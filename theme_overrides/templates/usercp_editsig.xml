<template name="usercp_editsig" version="1400"><![CDATA[<html>
<head>
<title>{$mybb->settings['bbname']} - {$lang->edit_sig}</title>
{$headerinclude}
</head>
<body>
{$header}
<form action="usercp.php" method="post" class="usercp_signature_form">
<input type="hidden" name="my_post_key" value="{$mybb->post_code}" />
<table width="100%" border="0" align="center" class="usercp_layout">
<tr>
{$usercpnav}
<td valign="top" class="usercp_content">
{$error}
{$signature}
<table border="0" cellspacing="{$theme['borderwidth']}" cellpadding="{$theme['tablespace']}" class="tborder usercp_signature_table">
<tr>
<td class="thead" colspan="2"><strong>{$lang->edit_sig}</strong></td>
</tr>
<tr class="usercp_signature_editor_row">
<td class="trow1 usercp_signature_note" valign="top" width="20%"><span class="smalltext">{$lang->edit_sig_note}</span>
{$smilieinserter}</td>
<td class="trow1 usercp_signature_editor" width="80%">
<textarea rows="15" cols="70" id="signature" name="signature">{$sig}</textarea>
{$codebuttons}
</td>
</tr>
<tr class="usercp_signature_settings_row">
<td class="trow2 usercp_signature_limits">
<span class="smalltext">{$lang->edit_sig_note2}</span>
</td>
<td class="trow2 usercp_signature_settings">
<span class="smalltext">
<label><input type="radio" class="radio" name="updateposts" value="enable" />&nbsp;{$lang->enable_sig_posts}</label><br />
<label><input type="radio" class="radio" name="updateposts" value="disable" />&nbsp;{$lang->disable_sig_posts}</label><br />
<label><input type="radio" class="radio" name="updateposts" value="0" checked="checked" />&nbsp;{$lang->leave_sig_settings}</label></span>
</td>
</tr>
</table>
<br />
<div align="center" class="usercp_signature_actions">
<input type="hidden" name="action" value="do_editsig" />
<input type="submit" class="button" name="submit" value="{$lang->update_sig}" />
<input type="submit" class="button" name="preview" value="{$lang->preview}" />
</div>
</td>
</tr>
</table>
</form>
{$footer}
</body>
</html>]]></template>
